    "lint:syntax": "node --check main.js && node --check game.js && node --check preload.js"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "electron": "^45.0.0"
  }
}